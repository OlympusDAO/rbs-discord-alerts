{
  "name": "rbs-discord-alerts",
  "main": "dist/index.js",
  "scripts": {
    "execute:events": "pnpm run build && node --env-file=.env dist/src/handlePriceEvents.js",
    "execute:heartbeats": "pnpm run build && node --env-file=.env dist/src/handleHeartbeat.js",
    "execute:snapshots": "pnpm run build && node --env-file=.env dist/src/handleSnapshotCheck.js",
    "execute:targetPrice": "pnpm run build && node --env-file=.env dist/src/handleTargetPriceChangedEvents.js",
    "execute:yrfmarkets": "pnpm run build && node --env-file=.env dist/src/handleYRFMarkets.js",
    "execute:emissionmanagermarkets": "pnpm run build && node --env-file=.env dist/src/handleEmissionManagerMarkets.js",
    "execute:failedperiodictasks": "pnpm run build && node --env-file=.env dist/src/handleFailedPeriodicTasks.js",
    "execute:bondmarketcreationfailed": "pnpm run build && node --env-file=.env dist/src/handleBondMarketCreationFailed.js",
    "execute:auctionparametersupdated": "pnpm run build && node --env-file=.env dist/src/handleAuctionParametersUpdated.js",
    "execute:auctionresult": "pnpm run build && node --env-file=.env dist/src/handleAuctionResult.js",
    "execute:claimedyield": "pnpm run build && node --env-file=.env dist/src/handleClaimedYield.js",
    "build": "tsc",
    "lint": "biome check --write .",
    "lint:check": "biome check .",
    "deploy:dev": "pnpm run build && pulumi up --stack dev",
    "deploy:prod": "pnpm run build && pulumi up --stack prod"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.11",
    "@graphql-typed-document-node/core": "^3.1.1",
    "@pulumi/gcp": "^9.37.2",
    "@pulumi/pulumi": "^3.274.1",
    "@types/jest": "^29.2.3",
    "@types/node": "^22.0.0",
    "jest": "^29.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "^4.9.5"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.0.0",
    "cross-fetch": "^3.1.5",
    "dedent-js": "^1.0.1"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11.28.11 <12",
    "npm": "use-pnpm",
    "yarn": "use-pnpm"
  },
  "packageManager": "pnpm@11.28.11"
}
